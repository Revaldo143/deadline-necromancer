# Deadline Necromancer configuration (copy to .env or export in your shell)

# Where Ollama serves local models. The app never calls a cloud LLM.
OLLAMA_HOST=http://localhost:11434

# Open-weight model used for resurrection plans.
# Smaller machines: gemma3:4b works well too.
NECRO_MODEL=gemma3:12b

# Folder scanned on first load (your projects folder).
DEFAULT_SCAN_PATH=~/projects

# Server bind
HOST=127.0.0.1
PORT=8000
